# ─────────────────────────────────────────────────────────────────────────────
# Upstream Watch — environment
#
# IMPORTANT: only the BRIGHTDATA_* and demo-app vars are read by this repo's code.
# The model-provider and Daytona keys are consumed by the TrueForge harness, not by
# our process — they are set in TrueForge Settings (or over its API, see below), and
# are listed here only so you know which accounts the project needs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bright Data — READ BY OUR CODE (pipeline/src/clients/brightdata.ts) ──────
# Web Unlocker API. Zone name is the zone you create in the Bright Data console.
# Docs: https://docs.brightdata.com/scraping-automation/web-unlocker/send-your-first-request
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# Optional; defaults to the value below. Only set it to override.
# BRIGHTDATA_ENDPOINT=https://api.brightdata.com/request

# ── Demo app — READ BY OUR CODE (demo-app/src/stripe.ts) ─────────────────────
# The watched service only builds request payloads in tests; no key is needed to run
# `pnpm verify`. Set these only if you want to point it at a real or fake Stripe.
STRIPE_API_KEY=
# STRIPE_API_BASE=https://api.stripe.com/v1
# PORT=3000

# ── Scraping mode ────────────────────────────────────────────────────────────
# Live is the default. DEMO_MODE=1 opts OUT, replaying the committed capture in
# agent/fixtures/html/<vendor>/current.html. See CLAUDE.md §5.
DEMO_MODE=0

# ─────────────────────────────────────────────────────────────────────────────
# NOT read by our code — configured in the TrueForge harness
# ─────────────────────────────────────────────────────────────────────────────
#
# Model provider (required before the agent can run at all).
# Harness accepts: openai, anthropic, google-gemini, fireworks, zai, moonshot,
# alibaba, together, custom.  Docs: https://trueforge.dev/models
#
#   curl -X POST http://localhost:8790/api/v1/settings/model-providers \
#     -H 'content-type: application/json' \
#     -d '{"type":"openai","api_key":"sk-..."}'
#
# Daytona sandbox (required for the patcher subagent).
#
#   curl -X PUT http://localhost:8790/api/v1/settings/sandbox-providers \
#     -H 'content-type: application/json' \
#     -d '{"data":[{"type":"daytona","api_key":"dtn_..."}]}'
#
# GitHub — already wired. The connector is header-PAT auth (not OAuth); it was
# configured from `gh auth token`. See specs/agent.md §Connector.
#
# Qodo — no credential here. It is a GitHub App installed on the repository.
#
# TrueForge local mode needs no API key. UI dev server proxies to:
# TRUEFORGE_URL=http://localhost:8790

# Optional. Point the dependency watcher at a mirror or a private registry.
# Unset means the public registry, which needs no credentials.
NPM_REGISTRY=
