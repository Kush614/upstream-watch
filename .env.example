# ── TrueForge harness ────────────────────────────────────────────────
# Local mode stores state in SQLite; no URL needed unless you move off localhost.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=              # VERIFY: local mode may not require one

# ── Model provider ───────────────────────────────────────────────────
# Configured in TrueForge Settings → Models. Kept here for pipeline-side calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=              # fallback only

# ── Bright Data (see CLAUDE.md §6) ───────────────────────────────────
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=                # VERIFY zone name from Bright Data setup

# ── Daytona sandbox ──────────────────────────────────────────────────
# Configured in TrueForge Settings → Sandbox providers. Mirrored here for scripts.
DAYTONA_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────
# The agent reaches GitHub through the GitHub MCP server (OAuth, configured in
# TrueForge Settings → Connectors). This token is only for local scripts / gh CLI.
GITHUB_TOKEN=
GITHUB_REPO=                    # e.g. your-user/upstream-watch

# ── Demo ─────────────────────────────────────────────────────────────
# 1 = serve cached HTML from agent/fixtures/html instead of hitting Bright Data.
DEMO_MODE=1
