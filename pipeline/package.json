{
  "name": "pipeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scraper runner, change detection, and self-repair.",
  "scripts": {
    "scrape": "node --env-file-if-exists=../.env --experimental-strip-types src/bin/scrape.ts",
    "repair": "node --env-file-if-exists=../.env --experimental-strip-types src/bin/repair.ts",
    "validate-spec": "node --env-file-if-exists=../.env --experimental-strip-types src/bin/validate-spec.ts",
    "pr:body": "node --env-file-if-exists=../.env --experimental-strip-types src/bin/pr-body.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "node-html-parser": "^9.0.2",
    "yaml": "^2.9.0"
  }
}
